[Unit]
Description=Voting App
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/voting-app/app
EnvironmentFile=/var/www/voting-app/.env
ExecStart=/var/www/voting-app/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
